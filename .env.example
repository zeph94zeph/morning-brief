# このファイルを .env にコピーして各値を書き換えてください
# Windows: copy .env.example .env

# Jina Reader API key (https://jina.ai/reader/)
JINA_API_KEY=your_jina_api_key_here

# Claude API key (https://platform.claude.com/) — 分析エンジン。未設定だと記事の見出しだけの簡易版になる
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gemini API key (https://aistudio.google.com/) — 代替案。settings.ts の claude.enabled=false のときだけ必要
GEMINI_API_KEY=your_gemini_api_key_here

# LINE Messaging API - チャネルアクセストークン
# LINE Developers > チャネル > Messaging API > チャネルアクセストークン
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# LINE ユーザーID（自分のLINEアカウントのユーザーID）
# LINE Developers > チャネル > Messaging API > 「あなたのユーザーID」
LINE_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
